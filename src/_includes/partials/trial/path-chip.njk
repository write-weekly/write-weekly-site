{#- Shows which path the visitor picked on /free-trial/, with a way back.
    Set `chipLabel` before including. The page script adds ?v= to the link. -#}
<div class="tf-chip-row">
  <span class="tf-chip"><span class="tf-chip-dot" aria-hidden="true"></span>{{ chipLabel }} <span aria-hidden="true">·</span> <a href="/free-trial/" id="change-link">change</a></span>
</div>
